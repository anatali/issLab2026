System robotsmart26

/*
 * ------------------------------------------------
 * Robot Control Messages
 * ------------------------------------------------
 * 
 * These messages define the interface for robot control operations.
 * They support both basic movement commands and advanced path planning.
 */  
//Request engage        : engage(OWNER, STEPTIME)	        "robot acquisition"
//Reply   engagedone    : engagedone(ARG)    for engage
//Reply   engagerefused : engagerefused(ARG) for engage
//Dispatch disengage    : disengage(ARG)                  "robot release"

Request tuneAtHome   : tuneAtHome(X)                  "reposition in home X don't care"
Reply tuneDone       : tuneDone(X)  for tuneAtHome
 
Dispatch cmd       	: cmd(MOVE)          				"command for basic move l|r|a|d|h"
Dispatch end       	: end(ARG)         					"termination of basicrobot"


Request  buildPlan   : buildPlan( PX,PY,TX,TY  )		"create plan from (PX,PY) to (TX,TY)"
Reply buildPlanDone  : buildPlanDone( PLAN ) for buildPlan

Request  doplan     : doplan( PATH, STEPTIME )			"execute path PATH with STEPTIME"
Reply doplandone    : doplandone( ARG )         for doplan
Reply doplanfailed  : doplanfailed( PLANTODO )  for doplan
 
Dispatch setrobotstate: setpos(X,Y,D) 		"set robot position to (X,Y) direction D=up|down|left|right" 
Dispatch setdirection : dir( D )  			"set robot direction to D=up|down|left|right" 

//Endosymbiotic integration of robotpos
Request moverobot    :  moverobot(TARGETX, TARGETY,STEPTIME)  	"move from current pos to (TARGETX,TARGETY)"
Reply moverobotdone  :  moverobotok(ARG)                    for moverobot
Reply moverobotfailed:  moverobotfailed(PLANDONE, PLANTODO) for moverobot
    
//Information requests 
Request getrobotstate : getrobotstate(ARG)		"request robot state ARG unused"
Reply robotstate      : robotstate(POS,DIR)  for getrobotstate  "POS->pos(X,Y) DIR->up|down|left|right"

Request getenvmap     : getenvmap(X)				"request environment map as string"
Reply   envmap        : envmap(MAP)  for getenvmap  "MAP->string "

Event alarm           : alarm(X)		"alarm event"

Dispatch setplanbuildelay : setplanbuildelay(V)		"set PlanDBuildDelay parameter = V > 0"
//{"ExecDelay":"120", "PlanDBuildDelay":"50", "FoundPathDelay":"500", "Callerfree":"unibocaller"}


/////////////////////////
Request  cmd    : cmd(MOVE,T)  "MOVE = w | s  mosse aril asynch"
Reply cmddone   : cmddone(R)          for cmd
Reply cmdfailed : cmdfailed(T,CAUSE)  for cmd

Request step       : step(TIME)	                        "step command for TIME duration"
Reply stepdone     : stepdone(V)                 for step
Reply stepfailed   : stepfailed(DURATION, CAUSE) for step

Dispatch move      : move(M)  "MOVE = l|r|a|d|h   mosse aril sincrone ok"

Event    vrinfo : vrinfo(SOURCE,INFO)       "streamed"
 
Event  sonaralarm : distance( DISTANCE ) 	"emesso per i client di sistema"	
Event  sonardata  : sonar( DISTANCE ) 	    "emesso dal SONAR"	

/* 
 * ------------------------------------------------
 * Internal Messages
 * ------------------------------------------------
 * 
 * These messages are used for internal communication between system components
 * and are not part of the external robot control interface.
 */   

//Request checkowner    : checkowner(CALLER)
//Reply checkownerok    : checkownerok(ARG)      for checkowner
//Reply checkownerfailed: checkownerfailed(ARG)  for checkowner

Dispatch noplan       : noplan(X)  //autodispatch in robotpos

Event  sonardata   : sonar( DISTANCE ) 	   
Event obstacle     : obstacle(X) 
Event info         : info(X)    

Dispatch nextmove     : nextmove(M)
Dispatch nomoremove   : nomoremove(M)
 
 
Context ctxrobotsmart ip [host="localhost" port=8020]

/* 
 * ------------------------------
 * robotsmart
 * ------------------------------
 */ 
QActor robotsmart context ctxrobotsmart {
	//withobj robot using "robots.VRObjForQak(myself,\"logs/robotsmart26.log\")"{

	State s0 initial{
		[# clearlog("./logs/robotsmart26.log") 	//vedi src/main/resources/logback.xml #]
		println("$name | starts ") color blue
		[# logger.info(  "${currentState.stateName}: starts"  ) #]

		println("$name | WAIT  before delegate ")  
 		delay 2000 //(B) attende creazione attori locali robotPos con  è lento

        delegate step to robotactor
        delegate move to robotactor
        
        
        		
		//[# System.exit(0) #]
	}
//	Transition t0
//		whenRequest step -> doStep
		
 
}

 /*
 * ------------------------------
 * robotactor
 * ------------------------------
 */ 
QActor robotactor context ctxrobotsmart 
        withobj rpos  using "smart.RobotPosUtils.getInstance()"
		withobj robot using "robots.VRObjForQak(myself,\"logs/robotsmart26.log\")"{  
		
 	[# var doingAsynchStep = false   
 	   val stepTime        = 345L     
 	   var CurTime         = 0L
 	#]  
	State s0 initial{
		println("$name STARTS") color blue
		[# clearlog("./logs/robotactor.log") 	//vedi src/main/resources/logback.xml #]
 		//[# robot.setTrace(true) #] 
 		subscribeTo robotactor for sonardata
  		subscribeTo robotactor for vrinfo
		println("$name subscribe to myself done") color blue
		[# robot.connect("localhost") #]
		
		//[# val rpos = smart.RobotPosUtils.getInstance() #]
		
		println("$name | at home ") color blue
		
		[#  rpos.robotAtHome(   ) #]
		
	} 
	Goto work
	
	State work{
		println("$name | work") color yellow 
	}
	Transition t0
	   whenMsg     move -> domove
	   whenRequest cmd  -> docmdreq
	   whenRequest step -> handleAsynchStep

	State handleAsynchStep{
		println("$name | handleAsynchStep $currentMsg") color blue
		memoCurrentTime CurTime
		[# doingAsynchStep = true  #]
		onMsg( step:step(T)){
			[# robot.forward(payloadArg(0).toInt() ) #]
		}
	}	
	Transition t0
	    //whenInterruptEvent sonardata  -> handleSonarData  
	    whenEvent vrinfo     -> handleVrinfoMsgReply	   

	State domove{
		//printCurrentMessage color blue
		onMsg( move : move(M) ){
			[# val Move = payloadArg(0);  #]
			if [# Move == "h" #] { [# robot.halt()         #]  }
 			//if [# Move == "p" #] { [# robot.step(stepTime) #]  }  //synch
			if [# Move == "a" || Move == "l" #]{ [# robot.turnLeft() #]  }
			if [# Move == "d" || Move == "r" #]{ [# robot.turnRight() #] }
		}
	} 
	Goto work

      
	/*
	 * Durante un movimento è stato rilveato un segnale dal sonar
	 */
	State handleSonarData{ 
		//printCurrentMessage color green  		 
		onMsg( sonardata : sonar(D) ){
			//memoCurrentTime SonardataDT
			println("$name | handleSonarData ") color green 
			[# var D = payloadArg(0) #]
			println("$name |  sonarval:distance($D) --- ") color black 
	//			[#  mqtt.publish("vrevents", "msg(sonarval,event,robotactor,ANY,distance(4),0)" ) #]
	    	
	    	//forward robotactor -m move : move(w)
	    	delay 2000
	    	
	    	emit sonaralarm :  distance($D)  
				//questo contesto NON SA che esiste altro => evento non propagato in assenza di MQTT			
		} 
		returnFromInterrupt
	} 
  
 
	State docmdreq{
		//printCurrentMessage color blue
		onMsg( cmd : cmd(M,T) ){
			[# val Move = payloadArg(0)
			   val T    = payloadArg(1).toInt() 
			#]
			println("$name | cmd $Move $T") color yellow
			//if [# Move == "h" #] { [# robot.halt()           #]    }
			//if [# Move == "p" #] { [# robot.forward(T)       #]    }   
			if [# Move == "w" #] { [# robot.forward(T)       #]    }
			if [# Move == "s" #] { [# robot.backward(T)      #]    }
			//if [# Move == "a" || Move == "l" #]{ [# robot.turnLeft() #]  }
			//if [# Move == "d" || Move == "r" #]{ [# robot.turnRight() #] }
		}
	}
	Transition t0 
		//whenInterruptEvent sonardata -> handleSonarData  
		whenEvent vrinfo             -> handleVrinfoMsgReply
	    whenMsg     move             -> domovewhilerunning
  
  	State domovewhilerunning{  
  		onMsg( move : move(M) ){
 			[# val Move = payloadArg(0);  #]
			//println("$name | domovewhilerunning $Move") color red
			if [# Move == "h" #] { [# robot.halt()         #]  }
 			if [# Move == "p" #] { [# robot.step(stepTime) #]  }  //synch
			if [# Move == "a" || Move == "l" #]{ [# robot.turnLeft() #]  }
			if [# Move == "d" || Move == "r" #]{ [# robot.turnRight() #] }
		}
  	}
 	Transition t0 
		whenEvent vrinfo  -> handleVrinfoMsgReply
	    whenMsg     move  -> domove
  	
  	
	/*
        --------------------------------------------
        GESTIONE DELLE INFO DEL SUPPORTO
        --------------------------------------------
	*/
    
	State handleVrinfoMsgReply{
		//printCurrentMessage
		[# var NOW = 0L; var TDONE = 0L #]
		memoCurrentTime NOW
		println("$name | handleVrinfoMsgReply $currentMsg doingAsynchStep=$doingAsynchStep") color red
		onMsg( vrinfo : vrinfo(S,R)){
				[# var S = payloadArg(0) #]
				[# val R = payloadArg(1) #]
 				
				if [# doingAsynchStep #]{  
 					if [# S.contains("ko") #] { 
						println("$name | reply asynchstep failed $R") color cyan
						[# TDONE = NOW - CurTime #]
						replyTo step with stepfailed : stepfailed($TDONE,ok)
						
					}else{
						println("$name | reply asynchstep done") color cyan
						replyTo step with stepdone : stepdone(ok)
						[# rpos.forwardStep()    #]  //update mind
					} 			
					[# doingAsynchStep = false #]
				}else{ //non step
				 if [# S.contains("ko") #] {
					replyTo cmd with cmdfailed : cmdfailed($S,$R)
				 }else{
				 	replyTo cmd with cmddone : cmddone($S)
				 }				 
				 }
		}
	}	
	Goto work


 
 }

 /*
 * ------------------------------
 * robotusagemock
 * ------------------------------
 */ 
QActor robotusagemock context ctxrobotsmart{
	State s0 initial{
		println("$name | starts ") color blue
		[# logger.info(  "${currentState.stateName}: starts"  ) #]
		delay 1000
       request robotsmart -m step : step( 345 )		
	}
	Transition t0
		whenReply stepdone   -> work
		whenReply stepfailed -> work
		
	State work{
		printCurrentMessage color green
	} 
	
}
